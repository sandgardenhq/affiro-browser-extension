{
    "manifest_version": 3,
    "name": "Affiro",
    "description": "Prove your typing is your own",
    "version": "0.2.2",
    "content_scripts": [
        {
            "matches": [ "<all_urls>"],
            "js": ["/browser-api.js", "/api-config.js", "/vendor/affiro.min.js", "/content_script.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
        "matches": ["<all_urls>"],
        "resources": ["popup.js"]
        }
    ],
    "background": {
        "service_worker": "/background.js",
        "scripts": ["/background.js"]
    },

    "action": {
        "default_icon": {
            "48": "/icon.png"
        },
        "default_title": "affiro",
        "default_popup": "popup/popup.html"
    },

    "permissions": [
        "storage",
        "webRequest"
    ],
    "host_permissions": [
        "*://classroom.google.com/*",
        "*://docs.google.com/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "affiro@sandgarden.com",
            "data_collection_permissions": {
                "required": [
                    "websiteActivity",
                    "websiteContent"
                ]
            }
        }
    }
}
